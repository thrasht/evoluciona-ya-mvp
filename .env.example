# Copy to .env.local and fill in. Never commit .env.local.

# Meta → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Any random string; paste the same value in Meta → WhatsApp → Configuration
WHATSAPP_VERIFY_TOKEN=

# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evoluciona_bot
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/evoluciona_bot

# LLM
OPENAI_API_KEY=
LLM_MODEL=
